generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Tab {
  id           String   @id @default(cuid())
  originalId   Int
  songId       Int
  tab          String
  taburl       String   @unique
  contributors String[]
  capo         Int
  tuning       String
  rating       Float
  version      Int
  type         String
  timestamp    String?  @default("2023-05-27T16:51:42.319Z") // should switch this to be a real datetime, but trpc can't serialize date objects so would need a wrapper around everything
  song         Song     @relation(fields: [songId], references: [id])

  @@index([originalId])
  @@index([songId])
  @@index([taburl])
}

model Song {
  id            Int            @id @default(autoincrement()) // this is dangerous here since we are using original song IDs
  name          String
  artist        String
  Tab           Tab[]
  possibleSongs PossibleSong[]

  @@index([name])
  @@index([artist])
}

model PossibleSong {
  id         Int    @id @default(autoincrement())
  name       String
  artist     String
  taburl     String @unique
  type       String
  originalId Int?

  createdOn DateTime @default(now())

  songId Int?

  song Song? @relation(fields: [songId], references: [id])

  @@index([taburl])
  @@index([name])
  @@index([artist])
  @@index([originalId])
}

model TrackTab {
  id             Int      @id @default(autoincrement())
  spotifyTrackId String
  taburl         String
  lastUpdated    DateTime @default(now())

  @@unique([spotifyTrackId])
}

// Identity is the edge-authenticated username (Basic auth, stamped by Caddy as
// X-Auth-User) — see src/server/auth.ts. Spotify is now an OPTIONAL linked
// account on that user, not the identity itself. This is what stops the
// Spotify dev-mode account cap from limiting who can log in: we own as many
// basic accounts as we want, and only link Spotify when needed (Connect flow).
model User {
  id                   String  @id @default(cuid())
  username             String  @unique // the edge identity (basicauth username)
  spotifyUserId        String? @unique // optional linked Spotify account id
  spotifyRefreshToken  String? // persisted so the server can act as the user

  folders Folder[]

  @@index([username])
}

model UserTablink {
  id       String   @id @default(cuid())
  taburl   String
  name     String?
  artist   String?
  type     String?
  version  Int?
  loadBest Boolean?

  folderId Int

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([taburl, folderId])
}

model Folder {
  id          Int     @id @default(autoincrement())
  name        String
  userId      String
  playlistUrl String? // only present if playlist was used to create folder
  imageUrl    String?

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tabs UserTablink[]

  @@unique([name, userId])
}